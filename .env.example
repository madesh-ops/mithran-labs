# Copy to .env.local (development) or set in your hosting provider's dashboard.
# Never commit real values.

# Public site URL — used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://mithranlabs.com

# Public contact details shown on the site. Email falls back to
# hello@mithranlabs.com if unset — replace it with an inbox you actually read.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional — hidden when empty.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_STUDIO_LOCATION=India
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=

# Email delivery for the contact form (https://resend.com).
# Until all three are set, the form says plainly that nothing was sent and
# offers a pre-filled email link instead — it never fakes a success.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Mithran Labs Website <website@mithranlabs.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
